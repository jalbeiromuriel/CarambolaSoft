%% ================= CAJA / FACTURACIÓN =================
class TurnoCaja {
  -UUID id
  -UUID usuarioId "sin tabla USUARIOS ni FK"
  -DateTime fechaApertura
  -DateTime fechaCierre
  -Decimal baseEfectivo
  -Decimal efectivoRealEntregado
  -bool esSincronizado
  -DateTime ultimaModificacion
  +abrir(base) void
  +cerrar(efectivo) void
  +estaAbierto() bool
  +calcularEfectivoEsperado() Decimal
  +calcularDiferencia() Decimal
}
class CierreDia {
  -UUID id
  -UUID turnoCajaId "único: 1 cierre por turno"
  -Date fecha
  -Decimal totalTiempo
  -Decimal totalLicor
  -Decimal totalOtros "no existe totalSnacks"
  -Decimal totalGeneral
  -Decimal totalFiado
  -Decimal totalGastos
  -Decimal totalPremiosMaq
  -Decimal totalCobrosFiado
  -Decimal efectivoReportado
  -Decimal descuadre
  -bool confirmado
  -bool esSincronizado
  -DateTime ultimaModificacion
  +calcularTotales() void
  +calcularDescuadre() Decimal
  +confirmarCierre() void
  +estaConfirmado() bool
  +agruparPorCliente() List
}
class Factura {
  -UUID id
  -UUID cuentaId "único: 1 factura por cuenta"
  -UUID turnoCajaId
  -int consecutivo "NUEVO v6.2 · único"
  -String numeroFactura "NUEVO v6.2 · F-#### calculado"
  -Decimal subtotalTiempo
  -Decimal subtotalLicor
  -Decimal subtotalSnacks
  -Decimal subtotalOtros "incluye no alcohólicas"
  -Decimal totalPagar "total original, no cambia"
  -Decimal totalPendienteFiado "saldo, baja con abonos"
  -MetodoPago metodoPago
  -MetodoPago metodoPagoSecundario
  -Decimal montoPrimario
  -Decimal montoSecundario
  -EstadoPago estadoPago
  -bool esSincronizado
  -DateTime ultimaModificacion
  +calcularTotal() Decimal
  +pagar(metodo) void
  +pagarMixto(m1, monto1, m2, monto2) void
  +registrarFiado(monto) void
  +anular() void
  +getDesglosePorCategoria() Map
}
class AbonoFiado {
  -UUID id
  -UUID facturaId
  -UUID turnoCajaId "turno que recaudó"
  -Decimal monto
  -MetodoPago metodoPago
  -DateTime fechaHora
  -Decimal deudaAntes "NUEVO v6.2"
  -Decimal deudaDespues "NUEVO v6.2"
  -bool esSincronizado
  -DateTime ultimaModificacion
  +aplicar() void
}
class GastoCaja {
  -UUID id
  -UUID turnoCajaId
  -String concepto
  -Decimal monto
  -CategoriaGasto categoria
  -MetodoPago metodoPago
  -DateTime fechaHora
  -bool esSincronizado
  -DateTime ultimaModificacion
  +registrar() void
}

%% ================= CUENTAS (eje comercial) =================
class Cuenta {
  -UUID id
  -UUID turnoCajaId
  -TipoCuenta tipoCuenta
  -UUID mesaId "nulo"
  -UUID clienteId "nulo"
  -String nombreLibre "cliente o nombre: anti-fantasma"
  -DateTime horaApertura
  -DateTime horaCierre
  -Decimal tarifaPorHora "taxímetro"
  -EstadoCuenta estado
  -UUID garitaRelojId "NUEVO v6.2 · nulo"
  -bool esSincronizado
  -DateTime ultimaModificacion
  +abrir() void
  +agregarPedido(producto, cantidad) PedidoCuenta
  +calcularSubtotalTiempo() Decimal
  +calcularSubtotalConsumos() Decimal
  +liquidar(pago) Factura
  +cancelar() void
  +estaAbierta() bool
}
class Cliente {
  -UUID id
  -String nombre
  -String apodo
  -bool activo
  -int visitas
  -Decimal gastoAcumulado
  -DateTime fechaRegistro
  -bool esSincronizado
  -DateTime ultimaModificacion
  +desactivar() void
  +getFiadoPendiente() Decimal
}
class GaritaReloj {
  -UUID id
  -String nombre
  -Decimal valor
  -DateTime inicioUtc "servidor, decisión 12"
  -DateTime proximoCobroUtc
  -int cobros
  -bool activa
  -bool esSincronizado
  -DateTime ultimaModificacion
  +iniciar(nombre, valor) void
  +cobrar(metodo) Cuenta
  +posponer(minutos) void
  +terminar() void
  +estaVencida() bool
}

%% ================= MESAS / JUEGO =================
class MesaBillar {
