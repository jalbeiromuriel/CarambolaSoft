%% Fuente: ElParcheDeJony_DB_v6.sql (SSMS, 2026-10-05). "NUEVO v6.2" = propuesta del delta, no ejecutada.
%% Cambios frente al UML v5: Cuenta pasa a ser el eje comercial; se agregan Cliente, GastoCaja, Maquina,
%% MaquinaMovimiento y Promocion; se quita Usuario (no existe tabla); Factura ya no tiene totalOriginal ni saldo.

%% ================= INTERFACES =================
class ISincronizable {
  <<interface>>
  +bool esSincronizado
  +DateTime ultimaModificacion
  +sincronizar() void
  +marcarPendiente() void
}
class IAuditable {
  <<interface>>
  +DateTime ultimaModificacion
  +registrarCambio() void
}
class IFacturable {
  <<interface>>
  +calcularSubtotalTiempo() Decimal
  +calcularSubtotalConsumos() Decimal
  +generarFactura() Factura
}

%% ================= ENUMERACIONES =================
class TipoMesa {
  <<enumeration>>
  POOL
  CARAMBOLA
  SNOOKER
}
class EstadoMesa {
  <<enumeration>>
  DISPONIBLE
  OCUPADA
  MANTENIMIENTO
}
class TipoCuenta {
  <<enumeration>>
  LICORES
  BILLAR
  CARTAS
  DOMINO
  VENTA_RAPIDA
  GARITA
}
class EstadoCuenta {
  <<enumeration>>
  ABIERTA
  LIQUIDADA
  CANCELADA
}
class EstadoPedido {
  <<enumeration>>
  PENDIENTE
  ENTREGADO
  CANCELADO
}
class CategoriaConsumo {
  <<enumeration>>
  TIEMPO
  BEBIDAS_ALCOHOLICAS
  SNACKS
  BEBIDAS_NO_ALCOHOLICAS
  OTROS
}
